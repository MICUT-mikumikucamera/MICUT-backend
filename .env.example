# 배포 서버(Render)의 환경 변수로 넣는 값. 실제 값은 Git에 올리지 않는다.
# 비워 두면 내 PC 모드(SQLite 파일, uploads/·results/ 폴더)로 동작한다.

# Supabase → Connect → Session pooler 연결 문자열 (비밀번호 포함)
DATABASE_URL=

# Supabase → Project Settings → API의 Project URL과 service_role 키
SUPABASE_URL=
SUPABASE_KEY=

# Storage 공개 버킷 이름
SUPABASE_BUCKET=micut
